# Configuración del frontend. Copiá este archivo como ".env" (opcional).
# IMPORTANTE: todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca pongas acá la API key de Claude: esa va solo en backend/.env.

# URL base de la API. En desarrollo se usa el proxy de Vite ("/api").
VITE_API_URL=/api

# Idioma del reconocimiento y la síntesis de voz (es-AR, es-ES, es-MX, ...).
VITE_SPEECH_LANG=es-AR
