# ─────────────────────────────────────────────────────────────
# Configuración del backend. Copiá este archivo como ".env".
# NUNCA subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Proveedor de IA:
#   "claude" → usa la API de Claude (necesita ANTHROPIC_API_KEY).
#   "mock"   → respuestas simuladas, sin red. Sirve para probar y para demos.
AI_PROVIDER=claude

# API key de Claude. Vive SOLO en el backend. El frontend nunca la ve.
ANTHROPIC_API_KEY=

# Modelo de Claude que se usa en todas las llamadas.
CLAUDE_MODEL=claude-opus-5

# Si el modelo rechaza un pedido por políticas de seguridad, la API puede
# reintentar sola con otro modelo ("fallback" del lado del servidor).
CLAUDE_SERVER_FALLBACKS=true

# Tiempo máximo (ms) de cada llamada a Claude y reintentos automáticos del SDK.
CLAUDE_TIMEOUT_MS=90000
CLAUDE_MAX_RETRIES=3

# Puerto HTTP del backend.
PORT=3001

# Origen del frontend permitido por CORS (separar varios con coma).
CORS_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite.
DATABASE_PATH=./data/entrevistas.db

# Privacidad: las sesiones se borran solas después de estas horas.
DATA_RETENTION_HOURS=24

# Límite de pedidos por IP y por minuto (protege el costo de la API).
RATE_LIMIT_PER_MINUTE=60
